# Salin jadi .env lalu isi. .env TIDAK ikut ke git.

# --- daftar putih grup -------------------------------------------------------
# Format: GRUP_<LABEL>=<jid>. LABEL inilah yang ditulis di kolom `grup` tiap sumber.
# Label yang tidak ada di sini akan DIBUANG dan dicatat di log.
# Belum tahu JID-nya? Jalankan `npm start` tanpa GRUP_* apa pun -> daftarnya dicetak.
GRUP_INTI=1203xxxxxxxxxxxxxx@g.us
GRUP_PANITIA=1203xxxxxxxxxxxxxx@g.us
GRUP_PUBLIKASI=1203xxxxxxxxxxxxxx@g.us

# --- sumber 2: Google Form -> Spreadsheet ------------------------------------
# Dibuat oleh setup-gform.gs (tempel ke script.google.com, Run > setup, lihat View > Logs).
# Bentuknya: https://docs.google.com/spreadsheets/d/<ID>/gviz/tq?tqx=out:csv&headers=1&gid=<GID>
# <GID> harus gid tab BOT, BUKAN tab respons Form: tab respons mengekspor tanggal ikut
# locale (8/28/2026) dan semua reminder dibuang diam-diam.
# Setelah diisi WAJIB: npm run check-sheet  -> harus lapor dibaca/dipakai/dibuang.
SHEET_CSV_URL=

# --- perilaku ----------------------------------------------------------------
DRY_RUN=true          # ganti ke false kalau sudah yakin. Default aman: cuma nge-log.
TICK_MS=60000
SEND_GAP_MS=3000
SESSION_NAME=brama    # -> folder brama_sessions/, JANGAN dihapus
